<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.linesql</groupId>
        <artifactId>linesql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>linesql-cli</artifactId>
    <name>linesql-cli</name>

    <dependencies>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-spark</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-hive</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-flink</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-starrocks</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-oracle</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.linesql</groupId>
            <artifactId>linesql-dialect-sqlserver</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.linesql.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
