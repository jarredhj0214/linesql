DOLLAR_QUOTED_STRING: '$$' .*? '$$';
IDENTIFIER: [a-zA-Z_$-￿] [a-zA-Z0-9_$-￿]*;
USER_VARIABLE
    : '@' ([a-zA-Z_$-￿] [a-zA-Z0-9_$-￿]*
          | '\'' ('\\' . | '\'\'' | ~['\\])* '\''
          | '"' ('\\' . | '""' | ~["\\])* '"'
          | '`' ('``' | ~'`')* '`')
    ;
BACKQUOTED_IDENTIFIER: '`' ('``' | ~'`')* '`';
STRING_LITERAL: '\'' ('\\' . | '\'\'' | ~['\\])* '\'';
DOUBLE_QUOTED_STRING: '"' ('\\' . | '""' | ~["\\])* '"';
NUMBER_LITERAL: [0-9]+ ('.' [0-9]+)?;

DOT: '.';
COMMA: ',';
SEMI: ';';
LPAREN: '(';
RPAREN: ')';
LBRACKET: '[';
RBRACKET: ']';
LBRACE: '{';
RBRACE: '}';
STAR: '*';
ARROW: '->';
EQ: '=';
PLUS: '+';
MINUS: '-';
SLASH: '/';
PERCENT: '%';
LT: '<';
GT: '>';
COLON: ':';
NEQ: '!=' | '<>';
LTE: '<=';
GTE: '>=';
CONCAT: '||';
VERTICAL_OUTPUT: '\\G';

LINE_COMMENT: '--' ~[\r\n]* -> skip;
BLOCK_COMMENT: '/*' .*? '*/' -> skip;
WS: [ \t\r\n]+ -> skip;
OTHER: .;

