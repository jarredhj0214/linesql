lexer grammar SqlServerLineageLexer;

SELECT: S E L E C T;
TOP: T O P;
WITH: W I T H;
INSERT: I N S E R T;
UPDATE: U P D A T E;
DELETE: D E L E T E;
MERGE: M E R G E;
MATCHED: M A T C H E D;
INTO: I N T O;
CREATE: C R E A T E;
DROP: D R O P;
TRUNCATE: T R U N C A T E;
ALTER: A L T E R;
SHOW: S H O W;
DESCRIBE: D E S C R I B E;
DESC: D E S C;
COMMENT: C O M M E N T;
OR: O R;
AND: A N D;
NOT: N O T;
TEMPORARY: T E M P O R A R Y;
TABLE: T A B L E;
VIEW: V I E W;
IF: I F;
EXISTS: E X I S T S;
AS: A S;
LIKE: L I K E;
RENAME: R E N A M E;
TO: T O;
COLUMN: C O L U M N;
SET: S E T;
