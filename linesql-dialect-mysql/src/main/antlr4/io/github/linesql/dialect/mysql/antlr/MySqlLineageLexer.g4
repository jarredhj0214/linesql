IDENTIFIER: [a-zA-Z_$-￿] [a-zA-Z0-9_$-￿]*;
BACKQUOTED_IDENTIFIER: '`' ('``' | ~'`')* '`';
TEMPLATE_VARIABLE: '$' '{' ~[}\r\n]+ '}';
USER_VARIABLE: '@' [a-zA-Z0-9_$]+;
AT_SIGN: '@';
HEX_LITERAL: [xX] '\'' [0-9a-fA-F]* '\'' | '0' [xX] [0-9a-fA-F]+;
BIT_LITERAL: [bB] '\'' [01]* '\'' | '0' [bB] [01]+;
CHARSET_STRING_LITERAL: '_' [a-zA-Z0-9]+ '\'' ('\\' . | '\'\'' | ~['\\])* '\'';
NATIONAL_STRING_LITERAL: [nN] '\'' ('\\' . | '\'\'' | ~['\\])* '\'';
STRING_LITERAL: '\'' ('\\' . | '\'\'' | ~['\\])* '\'';
DOUBLE_QUOTED_STRING: '"' ('\\' . | '""' | ~["\\])* '"';
NUMBER_LITERAL: ([0-9]+ ('.' [0-9]*)? | '.' [0-9]+) ([eE] [+-]? [0-9]+)?;

DOT: '.';
COMMA: ',';
SEMI: ';';
LPAREN: '(';
RPAREN: ')';
LBRACE: '{';
RBRACE: '}';
STAR: '*';
EQ: '=';
NEQ: '!=' | '<>';
NULL_SAFE_EQ: '<=>';
LTE: '<=';
GTE: '>=';
SHIFT_LEFT: '<<';
SHIFT_RIGHT: '>>';
JSON_UNQUOTE_ARROW: '->>';
JSON_ARROW: '->';
LT: '<';
GT: '>';
PLUS: '+';
MINUS: '-';
SLASH: '/';
PERCENT: '%';
CONCAT: '||';
LOGICAL_AND: '&&';
AMP: '&';
BAR: '|';
CARET: '^';
BANG: '!';
TILDE: '~';
QUESTION: '?';
ASSIGN: ':=';
COLON: ':';

LINE_COMMENT: ('--' ~[\r\n]* | '#' ~[\r\n]*) -> skip;
BLOCK_COMMENT: '/*' .*? '*/' -> skip;
WS: [ \t\r\n]+ -> skip;
OTHER: .;

