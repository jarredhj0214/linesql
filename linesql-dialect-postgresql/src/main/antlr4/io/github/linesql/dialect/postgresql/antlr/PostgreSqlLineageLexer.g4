TS_MATCH: '@@';
JSON_PATH_EXISTS: '@?';
JSON_PATH_DELETE: '#-';
ARRAY_OVERLAP: '&&';
QUESTION_PIPE: '?|';
QUESTION_AMP: '?&';
BANG_TILDE_STAR: '!~*';
BANG_TILDE: '!~';
TILDE_STAR: '~*';
TILDE: '~';
BANG: '!';
QUESTION: '?';
COLON: ':';
LBRACKET: '[';
RBRACKET: ']';

LINE_COMMENT: ('--' ~[\r\n]* | '#' (~[>\r\n-] ~[\r\n]*)?) -> skip;
BLOCK_COMMENT: '/*' {io.github.linesql.core.util.AntlrLexerUtils.consumeNestedBlockComment(this);} -> skip;
WS: [ \t\r\n]+ -> skip;
OTHER: .;

