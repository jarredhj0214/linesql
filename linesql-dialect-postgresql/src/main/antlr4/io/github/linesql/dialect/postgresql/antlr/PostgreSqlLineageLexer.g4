EQ: '=';
NEQ: '!=' | '<>';
VECTOR_L2: '<->';
VECTOR_INNER_PRODUCT: '<#>';
VECTOR_COSINE: '<=>';
VECTOR_L1: '<+>';
VECTOR_HAMMING: '<~>';
VECTOR_JACCARD: '<%>';
LTE: '<=';
